# =============================================================
# 统一配置 —— 所有 .sh 脚本 source 本文件
# 用法（两种都行）：
#   1) 直接改这里的默认值
#   2) 运行时用环境变量覆盖:  BOARD_IP=192.168.1.50 ./01_livestream_check.sh
# =============================================================

# --- 板子 ---
BOARD_IP="${BOARD_IP:-192.168.1.50}"      # 板子 IP（ssh 需免密）
SSH_USER="${SSH_USER:-root}"              # ssh 用户名

# --- 服务端口 / 挂载路径 ---
RTSP_PORT="${RTSP_PORT:-8554}"            # RTSP 服务器端口
RESULT_PORT="${RESULT_PORT:-9000}"        # TCP 结果服务器端口
LIVE0="${LIVE0:-live0}"                   # 相机 0 的 RTSP 挂载点
LIVE1="${LIVE1:-live1}"                   # 相机 1 的 RTSP 挂载点

# --- 板上进程（内存/CPU 采样用）---
# 注意：Linux 进程名 comm 最长 15 字符会被截断，pkill -x 时板上的
# rknn_yolov8_dual 会变成 rknn_yolov8_dua。这里用 pgrep -f（匹配完整命令行），
# 所以写成完整名字即可。
APP_PATTERN="${APP_PATTERN:-rknn_yolov8_dual_mpp}"

# --- 测试参数 ---
WIN="${WIN:-10}"                          # 每次探测/采样的窗口秒数
TEST_INTERVAL="${TEST_INTERVAL:-600}"     # 长稳时两次探测间隔秒数
FPS_NOMINAL="${FPS_NOMINAL:-30}"          # 标称帧率（代码里 RTSP_ENCODE_FPS）
BITRATE_BPS="${BITRATE_BPS:-4000000}"     # 标称码率（代码里 RTSP_ENCODE_BPS, 4Mbps）

# --- 结果目录 ---
LOG_DIR="${LOG_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/artifacts}"
mkdir -p "$LOG_DIR"
